# Copy this file to .env and fill it with the official Firebase Web App values.
# Firebase Console: Project settings > General > Your apps > Web app > Config.
# These EXPO_PUBLIC_* values are client identifiers, not a place for secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Default remains off. Set to true only in an ignored local .env after the
# project owner has approved profile testing against the deployed M2.3 Rules.
# This is a public feature flag, not a secret or authorization mechanism.
EXPO_PUBLIC_FIRESTORE_USER_PROFILES_ENABLED=false
