{
  "functions": [
    {
      "source": "functions",
      "codebase": "ocr",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        "coverage",
        ".env",
        ".env.*",
        ".runtimeconfig.json",
        ".firebase",
        "*.pem",
        "*.key",
        "*.p12",
        "*.pfx",
        "service-account*.json",
        "serviceAccountKey.json",
        "firebase-adminsdk*.json",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "medicare-ai-cf804",
          "appId": "1:354989416256:android:37d5c3468947b13902e4a5",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "medicare-ai-cf804",
          "configurations": {
            "android": "1:354989416256:android:37d5c3468947b13902e4a5"
          }
        }
      }
    }
  }
}
