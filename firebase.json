{
  "functions": [
    {
      "source": "functions",
      "codebase": "ocr",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        "coverage",
        ".env",
        ".env.*",
        ".runtimeconfig.json",
        ".firebase",
        "*.pem",
        "*.key",
        "*.p12",
        "*.pfx",
        "service-account*.json",
        "serviceAccountKey.json",
        "firebase-adminsdk*.json",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true
  }
}
